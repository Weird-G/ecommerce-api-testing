.then(res => {\n        if (res.code === '200') {\n          this.goodsData = res.data\n        } else {\n          this.$message.error(res.msg)\n        }\n      })\n    },\n    navTo(url) {\n      location.href = url\n    },\n  }\n}\n</script>\n\n<style scoped>\n.main-content {\n  min-height: 100vh;\n  /*overflow: hidden;*/\n  background-size: 100%;\n  background-color: #b8efcf;\n}\n.left {\n  width: 17%;\n  background-repeat: no-repeat;\n  //background-image: url('@/assets/imgs/left-img.png');\n  background-color: #b8efcf\n}\n.right {\n  width: 17%;\n  background-repeat: no-repeat;\n  background-color: #b8efcf;\n}\n.el-col-5{\n  width: 20%;\n  max-width: 20%;\n  padding: 10px 10px;\n}\n</style>"],"mappings":"AA6GA;EAEAA,KAAA;IACA;MACAC,IAAA,EAAAC,IAAA,CAAAC,KAAA,CAAAC,YAAA,CAAAC,OAAA;MACAC,QAAA;MACAC,GAAA;MACAC,MAAA;MACAC,SAAA;MACAC,aAAA;MACAC,YAAA,GACAC,OAAA,kCACAA,OAAA,kCACAA,OAAA,iCACA;MACAC,aAAA,GACAD,OAAA,kCACAA,OAAA,kCACAA,OAAA,iCACA;MACAE,cAAA,GACAF,OAAA,kCACAA,OAAA,kCACAA,OAAA;IAEA;EACA;EACAG,QAAA;IACA,KAAAC,QAAA;IACA,KAAAC,UAAA;IACA,KAAAC,SAAA;IACA,KAAAC,aAAA;EACA;EACA;EACAC,OAAA;IACAD,cAAA;MACA,KAAAE,QAAA,CAAAC,GAAA,qBAAAC,IAAA,CAAAC,GAAA;QACA,IAAAA,GAAA,CAAAC,IAAA;UACAC,OAAA,CAAAC,GAAA;UACA,KAAAjB,aAAA,GAAAc,GAAA,CAAAxB,IAAA;QACA;UACA,KAAA4B,QAAA,CAAAC,KAAA,CAAAL,GAAA,CAAAM,GAAA;QACA;MACA;IACA;IACAd,SAAA;MACA,KAAAK,QAAA,CAAAC,GAAA,oBAAAC,IAAA,CAAAC,GAAA;QACA,IAAAA,GAAA,CAAAC,IAAA;UACA,KAAAnB,QAAA,GAAAkB,GAAA,CAAAxB,IAAA;QACA;UACA,KAAA4B,QAAA,CAAAC,KAAA,CAAAL,GAAA,CAAAM,GAAA;QACA;MACA;IACA;IACAb,WAAA;MACA,KAAAI,QAAA,CAAAC,GAAA,sBAAAC,IAAA,CAAAC,GAAA;QACA,KAAAhB,MAAA,GAAAgB,GAAA,CAAAxB,IAAA;QACA,IAAA+B,CAAA;QACA,SAAAvB,MAAA,SAAAA,MAAA,CAAAwB,MAAA;UACA,KAAAzB,GAAA,QAAAC,MAAA,IAAAyB,OAAA;UACAC,WAAA;YACA,KAAA3B,GAAA,QAAAC,MAAA,CAAAuB,CAAA,EAAAE,OAAA;YACAF,CAAA;YACA,IAAAA,CAAA,UAAAvB,MAAA,CAAAwB,MAAA;cACAD,CAAA;YACA;UACA;QACA;MACA;IACA;IACAb,UAAA;MACA,KAAAG,QAAA,CAAAC,GAAA,uBAAAC,IAAA,CAAAC,GAAA;QACA,IAAAA,GAAA,CAAAC,IAAA;UACA,KAAAhB,SAAA,GAAAe,GAAA,CAAAxB,I